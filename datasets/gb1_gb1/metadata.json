  "tasks": {
    "relative_igg_fc_binding_fitness": {
      "instruction": "Predict the relative IgG-Fc binding fitness in the Wu et al. GB1 four-site assay. The remaining GB1 background is fixed to the assay reference; the reference residues at positions 39, 40, 41, and 54 are V, D, G, and V. Fitness is normalized relative to this reference.",
      "target_name": "relative_igg_fc_binding_fitness",
      "unit": "dimensionless",
      "type": "continuous",
      "field_description": "residues_at_positions_39_40_41_54: Four standard amino-acid one-letter codes in that position order."
    }
  },
  "field_descriptions": {
    "residues_at_positions_39_40_41_54": "Four standard amino-acid one-letter codes in that position order."
  },
  "invalid_label_examples": 9209,
  "excluded_source_rows": 41796,
  "split_policy": "Unassigned. Recommended mutation-depth evaluation: train on Hamming distance <= k from VDGV and test > k (k=1,2,3), deriving depth from input only. These recipes are not official assigned FLIP folds.",
  "missing_policy": "No labels are imputed. Only complete supported structures and finite observed source labels are emitted.",
  "precision_policy": "Candidate keeps parsed source numbers. Release formatter caps all numeric values at 12 significant digits.",
  "license": {
